{$APP_SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle /api {
		redir /api/ 308
	}

	# Strip the public /api prefix before forwarding requests to FastAPI.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Caddy automatically preserves WebSocket upgrades.
	handle /ws/* {
		reverse_proxy backend:8000
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# React Router owns application routes such as /app/dashboard/present.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
