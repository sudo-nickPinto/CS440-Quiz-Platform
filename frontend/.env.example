# Copy this file to .env and fill in the values from your Auth0 dashboard.
# .env is gitignored; never commit real values or any Client Secret.

# Auth0 tenant domain (Applications > your app > Settings > Domain)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Client ID of the Single Page Application (same Settings tab)
VITE_AUTH0_CLIENT_ID=your-client-id

# Identifier of the Auth0 API for our backend (Applications > APIs)
VITE_AUTH0_AUDIENCE=https://quiz-platform-api

# Where the FastAPI backend is running
VITE_API_BASE_URL=http://127.0.0.1:8001
