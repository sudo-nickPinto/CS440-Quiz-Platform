# Public port on the Docker host. Use 80 on Reclaim when this stack owns the
# environment's web port; 8080 is convenient for local verification.
APP_PORT=8080

# Public HTTPS port. Use 443 on Reclaim. The local default is 8443 so it does
# not require privileged host ports.
APP_HTTPS_PORT=8443

# Caddy site address. A public hostname enables automatic HTTPS and certificate
# renewal. Keep the http:// scheme for local development only.
APP_SITE_ADDRESS=http://localhost

# Public browser origin. In production, replace this with the HTTPS Reclaim or
# custom-domain URL and add the same URL in the Auth0 application settings.
CORS_ORIGINS=http://localhost:8080

# Auth0 values. The client ID and API identifier are public configuration;
# this app does not use or need an Auth0 client secret.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://quiz-platform-api

# Reclaim MySQL connection. DB_HOST may be the private hostname of a separate
# Reclaim MySQL node, or "db" when compose.mysql.yaml is used.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=quiz_platform
DB_USERNAME=quiz_app
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECT_TIMEOUT=10

# Only needed when compose.mysql.yaml creates the MySQL container.
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Optional full SQLAlchemy URL. Leave blank to use the DB_* values above.
DATABASE_URL=
