APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Direct connection from a CS machine:
DB_HOST=cray
DB_PORT=3306
DB_DATABASE=f26_cs440_quizdb
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CONNECT_TIMEOUT=5

# When using an SSH tunnel from your laptop, change the host and port to:
# DB_HOST=127.0.0.1
# DB_PORT=3307

# Optional full URL override for tests or CI:
# DATABASE_URL=mysql+pymysql://username:password@host:3306/database?charset=utf8mb4

# Optional migrated MySQL database for integration tests. For safety, its
# database name must contain "test".
# TEST_DATABASE_URL=mysql+pymysql://root:devpass@127.0.0.1:3307/quizdb_test?charset=utf8mb4

# Auth0: same tenant domain (no https://) and API identifier the frontend uses.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://quiz-platform-api

# Local dev database without the school network (Docker):
#   docker run -d --name quizdb-dev -e MYSQL_ROOT_PASSWORD=devpass \
#     -e MYSQL_DATABASE=quizdb -p 3307:3306 mysql:8.0
# then run ulugbek-err/migrations/*.up.sql and set DB_HOST=127.0.0.1, DB_PORT=3307,
# DB_DATABASE=quizdb, DB_USERNAME=root, DB_PASSWORD=devpass.
