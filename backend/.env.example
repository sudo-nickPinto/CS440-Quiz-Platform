# Copy to .env (gitignored). Must match the frontend's Auth0 values.

# Auth0 tenant domain, e.g. your-tenant.us.auth0.com (no https://)
AUTH0_DOMAIN=

# Identifier of the Auth0 API for this backend (same as VITE_AUTH0_AUDIENCE)
AUTH0_AUDIENCE=

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# MySQL. Local dev: docker run -d --name quizdb-dev -e MYSQL_ROOT_PASSWORD=devpass
#   -e MYSQL_DATABASE=quizdb -p 3307:3306 mysql:8.0   (then run the migrations in
#   ulugbek-err/migrations/). Hosted: point these at the Reclaim database.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=quizdb
